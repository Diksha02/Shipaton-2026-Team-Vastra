{
  "name": "vastra",
  "version": "0.0.0",
  "private": true,
  "description": "Personal AI wardrobe with a shopping layer. See PROJECT.md.",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:up": "docker compose up -d",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v && docker compose up -d",
    "env:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @vastra/db run generate",
    "db:migrate": "pnpm --filter @vastra/db run migrate",
    "db:studio": "pnpm --filter @vastra/db run studio",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
