# ---------------------------------------------------------------------------
# WARDROBE — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# SECURITY RULES (see PROJECT.md §3, §5):
#   1. Every key below is SERVER-SIDE ONLY. None of these may be bundled into
#      the mobile app or exposed to a client. Provider SDKs are called only
#      from apps/api and apps/worker, behind packages/providers interfaces.
#   2. The only values the client ever receives are the EXPO_PUBLIC_* keys at
#      the bottom, which are publishable-by-design.
#   3. Local infrastructure binds to 127.0.0.1 only (see docker-compose.yml).
#      Nothing in local dev listens on a public interface.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=3000
# Bind to loopback in local dev. Do not change to 0.0.0.0 without a reason.
API_HOST=127.0.0.1
# Public origin of the API, used for webhook URLs and the ingest User-Agent.
API_PUBLIC_URL=http://127.0.0.1:3000

# --- Database (Neon in prod, docker-compose locally) ------------------------
# Port 55432 deliberately: docker-compose maps the container's 5432 to 55432 on
# the host so it cannot collide with a native Postgres install.
DATABASE_URL=postgresql://vastra:vastra@127.0.0.1:55432/vastra

# --- Redis / BullMQ (Upstash in prod, docker-compose locally) ---------------
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (S3-compatible) -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vastra-dev
R2_ENDPOINT=
# Public base URL for served assets (CDN / r2.dev / custom domain).
R2_PUBLIC_BASE_URL=

# --- Firebase Auth ---------------------------------------------------------
# The project id alone. Firebase ID tokens are verified against Google's public
# JWKS, so the server needs no service-account key and holds no auth secret.
# Find it at: Firebase console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=

# --- RevenueCat ------------------------------------------------------------
# Secret API key — server only. Used by the reconciliation job.
REVENUECAT_SECRET_API_KEY=
# Verifies inbound webhook signatures. Required: unsigned webhooks are rejected.
REVENUECAT_WEBHOOK_SECRET=

# --- OneSignal -------------------------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Observability ---------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# --- AI / data providers (PROJECT.md §3) -----------------------------------
# Moderation pass 1
OPENAI_API_KEY=
# Moderation pass 2
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Garment tagging
XIMILAR_API_TOKEN=
# Try-on
FASHN_API_KEY=
# Bump to invalidate every cached try-on render (PROJECT.md §5.2).
TRYON_MODEL_VERSION=v1

# --- URL ingestion (PROJECT.md §5.3) ---------------------------------------
INGEST_USER_AGENT=WardrobeBot/1.0 (+https://example.com/bot)
INGEST_TIMEOUT_MS=5000
INGEST_HARD_CAP_MS=10000
INGEST_MAX_BYTES=2097152

# ---------------------------------------------------------------------------
# CLIENT-SAFE. These are compiled into the app bundle and are publishable
# by design. Never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# Firebase client config. Public by design — these identify the project, they do
# not authorise anything. Access is controlled by Firebase Security Rules and by
# our own API, never by hiding these values.
# Find them at: Firebase console -> Project settings -> General -> Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# The **web** OAuth client id (client_type 3) from google-services.json.
# Mandatory: the Android SDK only calls requestIdToken() when this is supplied,
# and without an ID token there is nothing to exchange for a Firebase credential.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# RevenueCat Test Store key (prefix `test_`). Platform-agnostic, sandbox only.
# Used when no store-specific key is set, so the paywall is testable before
# App Store Connect and Play Console products exist.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# Production keys, per store. These take precedence over the test key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
